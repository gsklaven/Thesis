# ==============================================================================
# Python & Virtual Environments
# ==============================================================================
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/
*.egg-info/

# ==============================================================================
# CodeQL Databases & Temporary Artifacts
# ==============================================================================
# CodeQL databases and the intermediate BQRS/trap files are huge
codeql_dbs/
codeql_db_*/
*.bqrs
**/db-*/
**/*.trap
**/*.trap.gz

# ==============================================================================
# Raw Malware Corpus (SENSITIVE + LARGE FILES)
# ==============================================================================
# The whole sources folder with the raw malware samples is excluded
dataset/sources/

# Old/legacy sample paths (just in case)
dataset/malware_samples/
dataset/malware_samples_datadog/
dataset/pypi_malregistry/
dataset/malicious-packages/

# ==============================================================================
# Vendor / Installed Dependencies
# ==============================================================================
vendor/
**/vendor/

# ==============================================================================
# Staging & Temporary Analysis Folders
# ==============================================================================
temp_malware_analysis/
temp_*/

# ==============================================================================
# Intermediate CodeQL Pipeline Results & Logs
# ==============================================================================
# The CSV files are generated by analysis.py
inference/codeql_pipeline/results/*.csv
inference/codeql_pipeline/results/dependency_tree.json

# Old results path (if it still exists)
behavior_chain/graph_creation/results/*.csv
behavior_chain/graph_creation/results/dependency_tree.json

# Error logs of batch analyses
results/error_logs/
**/_error_*.log
*.log

# ==============================================================================
# Large Vector Embeddings (Binary Files)
# ==============================================================================
# The vectors (.npy) are rebuilt by the scripts (build_*_index.py)
dataset/indexes/**/*.npy
*.npy

# NOTE: the metadata.json files of the index folders (rag_index, policy_index) are kept
!dataset/indexes/**/metadata.json
!dataset/indexes/**/policy_metadata.json

# ==============================================================================
# Behavior Chain JSONs (HUGE - rebuilt by batch_analyzer.py)
# ==============================================================================
# Generated automatically, they do not belong in version control
dataset/analyzed_chains/
dataset/rag_train_oversized/
# The large data is NOT in git: it is distributed as a GitHub Release (./run_pipeline.sh pack,
# see PIPELINE.md). final_diverse_subset/ is a copy of rag_train+rag_test (rebuilt by the rag stage).
dataset/final_diverse_subset/
dataset/rag_train/
dataset/rag_test/

# Intermediate dataset JSONs (large, generated by the preparation scripts)
dataset/malware_dataset_all_sources.json
# (malware_dataset_matched.json STAYS in git: analyze/rag/collect need it on every machine)
dataset/malware_dataset_unmatched.json
dataset/malware_dataset_deduped.json*
dataset/suspected_stale_reuse_pairs.json

# Backup files of malware_dataset
dataset/malware_dataset.json.*.bak

# sliced_behavior_chain.json is generated per analysis
inference/codeql_pipeline/results/sliced_behavior_chain.json

# Per-package LLM report JSONs (generated by llm_evaluator.py). From v12 on, the reports
# (~0.45 GB per ablation) go to the GitHub Release with the data; git keeps the summaries
# (results/test_set_summaries/, results/evaluation_summaries/). v1-v11 are already in the history.
results/report_*.json
results/v12*/
results/error_logs/
results/inference_logs/

# ==============================================================================
# OS / Editors
# ==============================================================================
.DS_Store
.idea/
.vscode/
*.swp
*.swo
dataset/benign_test_set/*.json

# Semgrep Rules License v1.0: internal use only, do not distribute
dataset/preparation/policy_sources/semgrep_rules.json

# ==============================================================================
# Archive (old/) & temporary download folders
# ==============================================================================
# old/: anything the pipeline no longer uses (old chains, old results, one-off scripts, logs)
old/
# Temporary download/extraction folder of the benign sdists (fetch_benign_test_set.py)
benign_downloads/
# run_pipeline.sh: logs, worker folders, pack files (uploaded to a GitHub Release, not to the repo)
logs/
work/
dist/
# Local settings (sources location, API keys) - NEVER in git. Template: .env.example
.env
# Summaries of test runs (RESULTS_SUFFIX=_smoke...) - not in git
results/*_summaries/*_smoke*.json

# symlink folders of the local-model subset (recreated by dataset/preparation/select_local_subset.py)
dataset/local_subset/
