# ==============================================================================
# Python & Virtual Environments
# ==============================================================================
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/
*.egg-info/

# ==============================================================================
# CodeQL Databases & Temporary Artifacts
# ==============================================================================
# Οι βάσεις CodeQL και τα ενδιάμεσα BQRS/trap files είναι τεράστια
codeql_dbs/
codeql_db_*/
*.bqrs
**/db-*/
**/*.trap
**/*.trap.gz

# ==============================================================================
# Raw Malware Corpus (ΕΥΑΙΣΘΗΤΑ + ΒΑΡΙΑ ΑΡΧΕΙΑ)
# ==============================================================================
# Εξαιρούμε ολόκληρο τον φάκελο sources με τα ακατέργαστα δείγματα malware
dataset/sources/

# Παλιές/Legacy διαδρομές δειγμάτων (για κάλυψη)
dataset/malware_samples/
dataset/malware_samples_datadog/
dataset/pypi_malregistry/
dataset/malicious-packages/

# ==============================================================================
# Vendor / Εγκατεστημένες Εξαρτήσεις
# ==============================================================================
vendor/
**/vendor/

# ==============================================================================
# Staging & Προσωρινοί Φάκελοι Ανάλυσης
# ==============================================================================
temp_malware_analysis/
temp_*/

# ==============================================================================
# Ενδιάμεσα Αποτελέσματα CodeQL Pipeline & Logs
# ==============================================================================
# Τα CSV παράγονται αυτόματα από το analysis.py
inference/codeql_pipeline/results/*.csv
inference/codeql_pipeline/results/dependency_tree.json

# Παλιά διαδρομή results (αν υπάρχει ακόμα)
behavior_chain/graph_creation/results/*.csv
behavior_chain/graph_creation/results/dependency_tree.json

# Error logs από μαζικές αναλύσεις
results/error_logs/
**/_error_*.log
*.log

# ==============================================================================
# Large Vector Embeddings (Binary Files)
# ==============================================================================
# Τα διανύσματα (.npy) αναπαράγονται από τα scripts (build_*_index.py)
dataset/indexes/**/*.npy
*.npy

# ΣΗΜΕΙΩΣΗ: Κρατάμε τα metadata.json στους φακέλους indexes (rag_index, policy_index)
!dataset/indexes/**/metadata.json
!dataset/indexes/**/policy_metadata.json

# ==============================================================================
# Behavior Chain JSONs (ΤΕΡΑΣΤΙΑ - αναπαράγονται από batch_analyzer.py)
# ==============================================================================
# Παράγονται αυτόματα και δεν ανήκουν στο VCS
dataset/analyzed_chains/
dataset/rag_train_oversized/
# Τα μεγάλα δεδομένα ΔΕΝ μπαίνουν στο git: διανέμονται ως GitHub Release (./run_pipeline.sh pack,
# βλ. PIPELINE.md). Το final_diverse_subset/ είναι αντίγραφο των rag_train+rag_test (το ξαναφτιάχνει το rag).
dataset/final_diverse_subset/
dataset/rag_train/
dataset/rag_test/

# Ενδιάμεσα dataset JSONs (βαριά, παράγονται από τα preparation scripts)
dataset/malware_dataset_all_sources.json
# (το malware_dataset_matched.json ΜΕΝΕΙ στο git: το χρειάζονται analyze/rag/collect σε κάθε μηχάνημα)
dataset/malware_dataset_unmatched.json
dataset/malware_dataset_deduped.json*
dataset/suspected_stale_reuse_pairs.json

# Backup αρχεία malware_dataset
dataset/malware_dataset.json.*.bak

# Το sliced_behavior_chain.json παράγεται ανά-ανάλυση
inference/codeql_pipeline/results/sliced_behavior_chain.json

# Per-package LLM report JSONs (generated by llm_evaluator.py). Από το v12 και μετά οι αναφορές
# (~0,45 GB ανά ablation) πάνε στο GitHub Release μαζί με τα δεδομένα· στο git μένουν οι συνόψεις
# (results/test_set_summaries/, results/evaluation_summaries/). Οι v1-v11 είναι ήδη στο ιστορικό.
results/report_*.json
results/v12*/
results/error_logs/
results/inference_logs/

# ==============================================================================
# OS / Editors
# ==============================================================================
.DS_Store
.idea/
.vscode/
*.swp
*.swo
dataset/benign_test_set/*.json

# Semgrep Rules License v1.0: internal use only, do not distribute
dataset/preparation/policy_sources/semgrep_rules.json

# ==============================================================================
# Αρχείο (old/) & προσωρινοί φάκελοι λήψεων
# ==============================================================================
# old/: ό,τι δεν χρησιμοποιεί πλέον το pipeline (παλιά chains, παλιά results, εφάπαξ scripts, logs)
old/
# Προσωρινός φάκελος λήψης/αποσυμπίεσης των benign sdists (fetch_benign_test_set.py)
benign_downloads/
# run_pipeline.sh: logs, φάκελοι εργασίας workers, αρχεία του pack (ανεβαίνουν σε GitHub Release, όχι στο repo)
logs/
work/
dist/
# Τοπικές ρυθμίσεις (θέση πηγών, κλειδιά API) - ΠΟΤΕ στο git. Υπόδειγμα: .env.example
.env
