# Τοπικές ρυθμίσεις για ΑΥΤΟ το μηχάνημα: θέση πηγών και κλειδιά API.
# Αντίγραψε το σε .env (ή τρέξε ./run_pipeline.sh setup) και συμπλήρωσε.
# Το .env ΔΕΝ ανεβαίνει στο git. Το διαβάζουν και το run_pipeline.sh και κάθε script Python
# (μέσω του dataset/preparation/utils.py). Ό,τι έχει οριστεί ήδη στο τερματικό (export) υπερισχύει.
# Τιμές με κενά: σε εισαγωγικά, π.χ. THESIS_SOURCES_DIR="/Volumes/My Disk".

# Φάκελος με τους κλώνους των πηγών malware (δίσκος USB ή τοπικός φάκελος).
# Μέσα του: malicious-packages/, pypi_malregistry/, pypi/, malicious-software-packages-dataset/,
# maloss-samples/  (τα κατεβάζει το: ./run_pipeline.sh sources)
THESIS_SOURCES_DIR=/path/to/sources

# ---- LLM για την αξιολόγηση (evaluate) ---------------------------------------------------
# Ποιο LLM: deepseek (τα πειράματα της εργασίας) | gemini | lmstudio (τοπικό) | openrouter
LLM_PROVIDER=deepseek
# Τα αποτελέσματα πάνε στο results/v12_<RAG_MODE> για deepseek και στο results/v12_<RAG_MODE>_<πάροχος>
# για τους άλλους, ώστε να μην αναμειγνύονται.

# deepseek - https://platform.deepseek.com
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-flash

# gemini - https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash

# lmstudio - τοπικό μοντέλο, τίποτα δεν φεύγει από τον υπολογιστή (LM Studio > Developer > Start Server)
# LM_STUDIO_URL=http://localhost:1234/v1
# LM_STUDIO_MODEL=local-model

# openrouter - https://openrouter.ai/keys (ΣΥΓΚΕΚΡΙΜΕΝΟ μοντέλο, όχι αυτόματος router)
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=deepseek/deepseek-chat

# LLM_MAX_WORKERS=8          # παράλληλες κλήσεις ανά πακέτο (προεπιλογή: 8 deepseek, 4 gemini/openrouter, 1 lmstudio)

# Προαιρετικά
# WORKERS=4                 # παράλληλες αναλύσεις CodeQL (≈ πυρήνες/2, 4GB RAM η καθεμία)
# THESIS_OSV_DIR=           # μόνο αν το malicious-packages ΔΕΝ είναι μέσα στο THESIS_SOURCES_DIR
