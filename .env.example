# Local settings for THIS machine: location of the sources and API keys.
# Copy it to .env (or run ./run_pipeline.sh setup) and fill it in.
# .env is NOT committed to git. It is read by run_pipeline.sh and by every Python script
# (through dataset/preparation/utils.py). Anything already set in the shell (export) wins.
# Values with spaces: in quotes, e.g. THESIS_SOURCES_DIR="/Volumes/My Disk".

# Folder with the clones of the malware sources (USB disk or local folder).
# Inside it: malicious-packages/, pypi_malregistry/, pypi/, malicious-software-packages-dataset/,
# maloss-samples/  (downloaded by: ./run_pipeline.sh sources)
THESIS_SOURCES_DIR=/path/to/sources

# ---- LLM for the evaluation (evaluate) ---------------------------------------------------
# Which LLM: deepseek (the thesis experiments) | gemini | lmstudio (local) | openrouter
LLM_PROVIDER=deepseek
# Results go to results/v12_<RAG_MODE> for deepseek and to results/v12_<RAG_MODE>_<provider>
# for the others, so that they are never mixed.

# deepseek - https://platform.deepseek.com
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-flash

# gemini - https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash

# lmstudio - local model, nothing leaves the computer (LM Studio > Developer > Start Server)
# LM_STUDIO_URL=http://localhost:1234/v1
# LM_STUDIO_MODEL=local-model

# openrouter - https://openrouter.ai/keys (a SPECIFIC model, not the automatic router)
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=deepseek/deepseek-chat

# LLM_MAX_WORKERS=8          # parallel calls per package (default: 8 deepseek, 4 gemini/openrouter, 1 lmstudio)

# Optional
# WORKERS=4                 # parallel CodeQL analyses (about cores/2, 4GB RAM each)
# THESIS_OSV_DIR=           # only if malicious-packages is NOT inside THESIS_SOURCES_DIR
